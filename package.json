{
  "name": "termstyle",
  "version": "0.1.0",
  "description": "CSS-like declarative terminal styling: colors, borders, padding, alignment. Zero dependencies. Port of Go's lipgloss concept.",
  "keywords": [
    "terminal",
    "ansi",
    "color",
    "style",
    "border",
    "box",
    "cli",
    "lipgloss",
    "chalk",
    "terminal-styling",
    "zero-dependency"
  ],
  "author": "trananhtung",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trananhtung/termstyle.git"
  },
  "homepage": "https://github.com/trananhtung/termstyle#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
